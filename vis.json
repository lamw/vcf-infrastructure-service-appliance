{
  "min_packer_version": "1.6.3",
  "variables": {
    "vis_ovf_template": "vis.xml.template",
    "ovftool_deploy_vcenter": "192.168.30.3",
    "ovftool_deploy_vcenter_username": "administrator@vsphere.local",
    "ovftool_deploy_vcenter_password": "VMware1!",
    "disk_size": "40960",
    "depot_disk_size": "204800",
    "sftp_disk_size": "15360",
    "registry_disk_size": "61440",
    "dns_disk_size": "2048",
    "identity_disk_size": "2048",
    "vis_appliance_fqdn": "vis.vcf.lab",
    "vis_appliance_ip": "172.30.0.9",
    "vis_admin_username": "admin",
    "vis_admin_password": "VMware1!",
    "vis_sftp_user": "",
    "vis_sftp_password": "",
    "vis_pod_cidr_network": "10.10.0.0/16",
    "install_vcf_download_tool": "false",
    "harbor_version": "v2.15.1",
    "harbor_port": "9443",
    "harbor_http_port": "9080",
    "harbor_admin_password": "",
    "keycloak_image": "quay.io/keycloak/keycloak:26.3"
  },
  "builders": [
    {
      "type": "vmware-iso",
      "vm_name": "{{ user `vm_name` }}",
      "guest_os_type": "ubuntu-64",
      "version": "13",
      "disk_size": "{{ user `disk_size` }}",
      "disk_additional_size": [
        "{{ user `depot_disk_size` }}",
        "{{ user `sftp_disk_size` }}",
        "{{ user `registry_disk_size` }}",
        "{{ user `dns_disk_size` }}",
        "{{ user `identity_disk_size` }}"
      ],
      "disk_type_id": "thin",
      "boot_command": [
        "<esc><wait>",
        "c<wait>",
        "linux /casper/vmlinuz autoinstall ds=nocloud-net\\;s=http://{{ .HTTPIP }}:{{ .HTTPPort }}/ ---<enter><wait>",
        "initrd /casper/initrd<enter><wait>",
        "boot<enter>"
      ],
      "boot_wait": "5s",
      "boot_keygroup_interval": "500ms",
      "headless": false,
      "vnc_over_websocket": true,
      "insecure_connection": true,
      "iso_url": "{{ user `iso_url` }}",
      "iso_checksum": "{{ user `iso_checksum` }}",
      "http_directory": "http",
      "remote_type": "esx5",
      "remote_host": "{{ user `builder_host` }}",
      "remote_datastore": "{{ user `builder_host_datastore` }}",
      "remote_username": "{{ user `builder_host_username` }}",
      "remote_password": "{{ user `builder_host_password` }}",
      "ssh_username": "{{ user `guest_username` }}",
      "ssh_password": "{{ user `guest_password` }}",
      "ssh_port": 22,
      "ssh_timeout": "90m",
      "format": "ovf",
      "shutdown_command": "echo '{{ user `guest_password` }}' | sudo -S shutdown -P now",
      "shutdown_timeout": "15m",
      "vmx_data": {
        "numvcpus": "{{ user `numvcpus` }}",
        "memsize": "{{ user `ramsize` }}",
        "ethernet0.networkName": "{{ user `builder_host_portgroup` }}",
        "ethernet0.present": "TRUE",
        "ethernet0.startConnected": "TRUE",
        "ethernet0.virtualDev": "vmxnet3",
        "ethernet0.addressType": "generated",
        "ethernet0.wakeOnPcktRcv": "FALSE",
        "annotation": "VCF Infrastructure Services Appliance|0AVersion: {{ user `version` }}"
      }
    }
  ],
  "provisioners": [
    {
      "type": "shell-local",
      "inline": [
        "rm -rf http/optional-artifacts",
        "mkdir -p http/optional-artifacts",
        "touch http/optional-artifacts/.keep",
        "sh -c 'if [ \"{{ user `install_vcf_download_tool` }}\" = \"true\" ]; then set -- artifacts/vcf-download-tool-*; if [ -e \"$1\" ]; then cp \"$1\" http/optional-artifacts/vcf-download-tool-local.tar.gz; else : > http/optional-artifacts/vcf-download-tool-local.tar.gz; fi; else : > http/optional-artifacts/vcf-download-tool-local.tar.gz; fi'"
      ]
    },
    {
      "type": "shell",
      "execute_command": "echo '{{ user `guest_password` }}' | {{ .Vars }} sudo -S -E bash '{{ .Path }}'",
      "scripts": [
        "scripts/vis-settings.sh"
      ]
    },
    {
      "type": "file",
      "source": "vis",
      "destination": "/tmp"
    },
    {
      "type": "file",
      "source": "files/vis-redirect.service",
      "destination": "/tmp/vis-redirect.service"
    },
    {
      "type": "file",
      "source": "scripts/vis-update.sh",
      "destination": "/tmp/vis-update.sh"
    },
    {
      "type": "file",
      "source": "scripts/vis-apply-update.sh",
      "destination": "/tmp/vis-apply-update.sh"
    },
    {
      "type": "shell",
      "inline": [
        "mkdir -p /tmp/vis-optional-files",
        "if [ -n \"${PACKER_HTTP_ADDR:-}\" ]; then curl -fsS -o /tmp/vis-optional-files/vcf-download-tool-local.tar.gz \"http://${PACKER_HTTP_ADDR}/optional-artifacts/vcf-download-tool-local.tar.gz\" || :; fi"
      ]
    },
    {
      "type": "shell",
      "execute_command": "echo '{{ user `guest_password` }}' | {{ .Vars }} sudo -S -E bash '{{ .Path }}'",
      "environment_vars": [
        "VIS_INSTALL_VCF_DOWNLOAD_TOOL={{ user `install_vcf_download_tool` }}"
      ],
      "scripts": [
        "scripts/vis-download-tool.sh"
      ]
    },
    {
      "type": "shell",
      "execute_command": "echo '{{ user `guest_password` }}' | {{ .Vars }} sudo -S -E bash '{{ .Path }}'",
      "environment_vars": [
        "VIS_APPLIANCE_FQDN={{ user `vis_appliance_fqdn` }}",
        "VIS_APPLIANCE_IP={{ user `vis_appliance_ip` }}",
        "VIS_ADMIN_USERNAME={{ user `vis_admin_username` }}",
        "VIS_ADMIN_PASSWORD={{ user `vis_admin_password` }}",
        "VIS_SFTP_USER={{ user `vis_sftp_user` }}",
        "VIS_SFTP_PASSWORD={{ user `vis_sftp_password` }}"
      ],
      "scripts": [
        "scripts/vis-services.sh"
      ]
    },
    {
      "type": "shell",
      "execute_command": "echo '{{ user `guest_password` }}' | {{ .Vars }} sudo -S -E bash '{{ .Path }}'",
      "environment_vars": [
        "VIS_APPLIANCE_FQDN={{ user `vis_appliance_fqdn` }}",
        "VIS_APPLIANCE_IP={{ user `vis_appliance_ip` }}",
        "VIS_POD_CIDR_NETWORK={{ user `vis_pod_cidr_network` }}",
        "HARBOR_VERSION={{ user `harbor_version` }}",
        "VIS_KEYCLOAK_IMAGE={{ user `keycloak_image` }}",
        "VIS_HARBOR_PORT={{ user `harbor_port` }}",
        "VIS_HARBOR_HTTP_PORT={{ user `harbor_http_port` }}",
        "VIS_HARBOR_ADMIN_PASSWORD={{ user `harbor_admin_password` }}"
      ],
      "scripts": [
        "scripts/vis-harbor.sh"
      ]
    },
    {
      "type": "shell",
      "execute_command": "echo '{{ user `guest_password` }}' | {{ .Vars }} sudo -S -E bash '{{ .Path }}'",
      "pause_before": "10s",
      "scripts": [
        "scripts/vis-cleanup.sh"
      ]
    },
    {
      "type": "file",
      "source": "files/rc.local",
      "destination": "/tmp/rc.local"
    },
    {
      "type": "file",
      "source": "files/getOvfProperty.py",
      "destination": "/tmp/getOvfProperty.py"
    },
    {
      "type": "file",
      "source": "files/setup.sh",
      "destination": "/tmp/setup.sh"
    },
    {
      "type": "file",
      "source": "files/setup-01-os.sh",
      "destination": "/tmp/setup-01-os.sh"
    },
    {
      "type": "file",
      "source": "files/setup-02-network.sh",
      "destination": "/tmp/setup-02-network.sh"
    },
    {
      "type": "file",
      "source": "files/setup-03-vis.sh",
      "destination": "/tmp/setup-03-vis.sh"
    },
    {
      "type": "shell",
      "execute_command": "echo '{{ user `guest_password` }}' | {{ .Vars }} sudo -S -E bash '{{ .Path }}'",
      "scripts": [
        "scripts/vis-firstboot.sh"
      ]
    }
  ],
  "post-processors": [
    {
      "type": "shell-local",
      "environment_vars": [
        "VIS_VERSION={{ user `version` }}",
        "VIS_APPLIANCE_NAME={{ user `vm_name` }}",
        "FINAL_VIS_APPLIANCE_NAME={{ user `vm_name` }}",
        "VIS_OVF_TEMPLATE={{ user `vis_ovf_template` }}"
      ],
      "inline": [
        "cd manual",
        "./add_ovf_properties.sh"
      ]
    }
  ]
}
